# Configurações do Banco de Dados PostgreSQL Externo (Supabase, Neon, Render, Railway ou Local)
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
PORT=8080

# SMTP para envio dos links de recuperação (preencha no arquivo .env, não neste exemplo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Para Gmail, use a senha de app sem os espaços de formatação.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
APP_BASE_URL=http://localhost:3000
